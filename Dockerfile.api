# FastAPI inference server:  docker build -f Dockerfile.api -t rul-api . && docker run -p 8000:8000 rul-api
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ARTIFACTS_DIR=demo_assets \
    MODELS_DIR=demo_assets

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .
COPY configs/ ./configs/
COPY src/ ./src/
COPY demo_assets/ ./demo_assets/

RUN useradd -m -u 1000 appuser && mkdir -p /app/logs && chown -R appuser /app
USER appuser

EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
